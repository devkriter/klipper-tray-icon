<modules:ModulePanel x:Class="KlipperTrayIcon.Modules.Spoolman.SpoolmanPanel"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:modules="clr-namespace:KlipperTrayIcon.Modules"
                     xmlns:local="clr-namespace:KlipperTrayIcon.Modules.Spoolman">
    <!-- Spoolman: the spool(s) in the printer, and the other spools to switch to, in the popup's side panel. -->
    <modules:ModulePanel.Resources>
        <!-- Use: small and quiet, like the queue's Start next. Blue when it asks for the second click. -->
        <Style x:Key="UseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small borderless buttons: the filter's magnifier, and Open Spoolman. -->
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Load and Unload: a small outlined button in blue. Filled blue while it waits for the second
             click (Tag "armed"), dim when it can't run; its tooltip says why, even then. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#60CDFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#2F4A5A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F2A33" />
                            </Trigger>
                            <Trigger Property="Tag" Value="armed">
                                <Setter TargetName="Bg" Property="Background" Value="#60CDFF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#60CDFF" />
                                <Setter Property="Foreground" Value="#002033" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A thin, dark scroll bar that doesn't compete with the content. -->
        <Style x:Key="SubtleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="#3A3A3A" CornerRadius="2" Width="4"
                                                    HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#5A5A5A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One of the other spools: its colour and what's left, its name, material, place and when it was last
             used, and what's left in grams and metres. Hovering swaps the weight for Use, and after a moment
             shows the rest of what Spoolman knows. -->
        <DataTemplate x:Key="SpoolRow">
            <Border x:Name="Row" Background="Transparent" Padding="14,5,10,5"
                    ToolTipService.InitialShowDelay="600" ToolTipService.ShowDuration="60000">
                <Border.ToolTip>
                    <ToolTip Background="#2B2B2B" BorderBrush="#454545" Foreground="#DADADA" Padding="10,8" MaxWidth="300">
                        <StackPanel>
                            <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding TipTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#F2F2F2" />
                                <Run Text="{Binding TipId, Mode=OneWay}" Foreground="#8A8A8A" />
                            </TextBlock>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TipLabels}" Foreground="#8A8A8A" FontSize="11.5" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding TipValues}" FontSize="11.5" />
                            </Grid>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:SpoolRing Width="20" Height="20" Colors="{Binding Spool.Colors}" Fraction="{Binding Fraction}"
                                     Hub="#141414" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="#DADADA" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Sub}" Foreground="#8A8A8A" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="44">
                        <StackPanel x:Name="Weight" HorizontalAlignment="Right">
                            <TextBlock x:Name="Grams" Text="{Binding Weight}" Foreground="#DADADA" FontSize="13" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Length}" Foreground="#8A8A8A" FontSize="11" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button x:Name="Use" Style="{StaticResource UseButton}" Content="{Binding Use}" Tag="{Binding}"
                                HorizontalAlignment="Right" Visibility="Hidden" Click="OnUseClick" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Low}" Value="True">
                    <Setter TargetName="Grams" Property="Foreground" Value="#E3B341" />
                </DataTrigger>
                <DataTrigger Binding="{Binding VeryLow}" Value="True">
                    <Setter TargetName="Grams" Property="Foreground" Value="#FF7B72" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#222222" />
                    <Setter TargetName="Weight" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Use" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding Armed}" Value="True">
                    <Setter TargetName="Weight" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Use" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Use" Property="Background" Value="#60CDFF" />
                    <Setter TargetName="Use" Property="BorderBrush" Value="#60CDFF" />
                    <Setter TargetName="Use" Property="Foreground" Value="#002033" />
                    <Setter TargetName="Use" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </modules:ModulePanel.Resources>
    <DockPanel>
        <!-- Whether Spoolman is connected, and who reports usage. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="14,5">
            <Grid>
                <TextBlock FontSize="11" Foreground="#8A8A8A">
                    <Run x:Name="FootDot" Text="●" Foreground="#3FB950" /><Run x:Name="FootText" Text=" Connecting…" />
                </TextBlock>
                <TextBlock Text="usage is reported by Moonraker" FontSize="11" Foreground="#8A8A8A" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <!-- While Use waits for its second click, during a print. -->
        <Border x:Name="SwitchNote" DockPanel.Dock="Bottom" Background="#1F2A33" CornerRadius="5" Margin="10,4,10,8" Padding="10,7"
                Visibility="Collapsed">
            <TextBlock Text="While printing, switching moves the rest of this print's usage to the new spool."
                       Foreground="#B9DCF2" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <!-- The spools in the printer and the others scroll together: with several toolheads the cards fill the page. -->
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SubtleScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel>
                <!-- Spoolman or the printer isn't answering. -->
                <Border x:Name="Banner" Background="#3A2F12" CornerRadius="5" Margin="10,10,10,0" Padding="10,7"
                        Visibility="Collapsed">
                    <TextBlock x:Name="BannerText" Foreground="#F0D58A" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- IN THE PRINTER, with Load and Unload on the right: the printer's macros, each after a second click. -->
                <Grid Margin="14,9,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoadedHeader" Text="IN THE PRINTER" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="LoadButton" Grid.Column="1" Style="{StaticResource ActionButton}" Content="Load"
                            Click="OnActionClick" />
                    <Button x:Name="UnloadButton" Grid.Column="2" Style="{StaticResource ActionButton}" Content="Unload"
                            Margin="4,0,0,0" Click="OnActionClick" />
                </Grid>
                <!-- What Load or Unload is doing, how it went, or why it failed. -->
                <Border x:Name="ActionNote" Background="#1F2A33" CornerRadius="5" Margin="10,0,10,6" Padding="10,7"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ActionText" Foreground="#B9DCF2" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <!-- The spool in the printer (one big card), or one small card for each toolhead. -->
                <StackPanel x:Name="Cards" Margin="10,0" />

                <!-- OTHER SPOOLS · N, with a magnifier on its left that opens a filter on the same line, and
                     Open Spoolman on the right. -->
                <Grid Margin="8,10,10,4" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenButton" Grid.Column="2" Style="{StaticResource QuietButton}" Padding="4,1" Margin="6,0,0,0"
                            Visibility="Collapsed" Click="OnOpenClick" ToolTip="Edit, weigh and add spools in Spoolman">
                        <TextBlock Text="Open Spoolman ↗" Foreground="#60CDFF" FontSize="11" />
                    </Button>
                    <Button x:Name="FilterButton" Style="{StaticResource QuietButton}" Width="22" Height="22" Padding="0"
                            Click="OnFilterClick" ToolTip="Filter by name, material or place">
                        <Canvas Width="12" Height="12">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="7.5" Height="7.5" Stroke="#9A9A9A" StrokeThickness="1.3" />
                            <Line X1="7.5" Y1="7.5" X2="11.2" Y2="11.2" Stroke="#9A9A9A" StrokeThickness="1.4" />
                        </Canvas>
                    </Button>
                    <TextBlock x:Name="OthersHeader" Grid.Column="1" Text="OTHER SPOOLS" Foreground="#9A9A9A" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBox x:Name="FilterBox" Grid.Column="1" Margin="4,0,0,0" Visibility="Collapsed" FontSize="12"
                             Background="#1F1F1F" Foreground="#DADADA" BorderBrush="#3A3A3A" CaretBrush="#DADADA"
                             VerticalContentAlignment="Center" Padding="4,0" MinHeight="0" Height="22"
                             TextChanged="OnFilterChanged" PreviewKeyDown="OnFilterKey" LostKeyboardFocus="OnFilterLostFocus"
                             ToolTip="Filter by name, material or place" />
                </Grid>
                <TextBlock x:Name="ListNote" Foreground="#8C8C8C" FontSize="12" FontStyle="Italic"
                           TextWrapping="Wrap" Margin="14,2,14,4" Visibility="Collapsed" />
                <ItemsControl x:Name="SpoolList" ItemTemplate="{StaticResource SpoolRow}" Margin="0,0,0,6" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</modules:ModulePanel>
