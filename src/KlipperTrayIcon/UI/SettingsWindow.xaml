<Window x:Class="KlipperTrayIcon.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klipper Tray Icon Settings"
        SizeToContent="Height"
        Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <!-- In the open list each stream has a line saying what it is; the closed box shows just its name.
             Streams the camera doesn't offer are greyed out and can't be picked. -->
        <DataTemplate x:Key="StreamItem">
            <StackPanel Margin="0,3">
                <TextBlock x:Name="Label" Text="{Binding Label}" />
                <TextBlock x:Name="Description" Text="{Binding Description}" FontSize="12" Opacity="0.65"
                           TextWrapping="Wrap" MaxWidth="320" Margin="0,2,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Description}" Value="">
                    <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="Label" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="StreamItemContainer" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="IsEnabled" Value="{Binding Available}" />
        </Style>
        <ToolTip x:Key="StreamTip">
            <TextBlock TextWrapping="Wrap" MaxWidth="360">
                <Run Text="How the picture is fetched. Streams this camera doesn't offer are greyed out." FontWeight="SemiBold" />
                <LineBreak /><LineBreak />
                <Run Text="•  RTSP: compressed H.264 video over RTSP, the standard protocol for network cameras." />
                <LineBreak />
                <Run Text="•  H.264: the same video as a plain stream over HTTP, without RTSP's timing. RTSP is better when both are offered. Both use far less bandwidth than MJPEG." />
                <LineBreak />
                <Run Text="•  MJPEG: a continuous series of JPEG pictures. Works with almost every camera." />
                <LineBreak />
                <Run Text="•  Snapshots: single pictures, fetched about ten times a second." />
                <LineBreak /><LineBreak />
                <Run Text="Automatic uses the best one the camera offers, and switches to MJPEG if RTSP or H.264 keeps dropping." />
            </TextBlock>
        </ToolTip>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <!-- A slot of the stats strip picker: drawn like the strip's tile, with the label it'll show. -->
        <Style x:Key="StatsSlot" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,0,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="9" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The eye inside a secret's field: shows or hides what's typed. -->
        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="ToolTip" Value="Show" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Margin="0,4">
                            <TextBlock x:Name="Icon" Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Text" Value="&#xED1A;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="Hide" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,22,28,24">
        <!-- First run only -->
        <StackPanel x:Name="WelcomePanel" Visibility="Collapsed" Margin="0,0,0,18">
            <TextBlock Text="Welcome!" FontSize="26" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Tell the tray icon which printer to watch. You can change this later from the tray menu under Settings." />
        </StackPanel>

        <TextBlock Text="Printer" Style="{StaticResource SectionHeader}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="KlipperRadio" Content="Klipper (Mainsail / Fluidd)" GroupName="Type"
                         Margin="0,0,24,0" Checked="OnTypeChanged" />
            <RadioButton x:Name="U1Radio" Content="U1 Extended" GroupName="Type" Margin="0,0,24,0"
                         Checked="OnTypeChanged" ToolTip="Snapmaker U1 with paxx12's extended firmware (it requires it): Klipper, plus the printer's touchscreen" />
            <RadioButton x:Name="BambuRadio" Content="Bambu Lab" GroupName="Type" Checked="OnTypeChanged" />
        </StackPanel>

        <!-- Klipper -->
        <Grid x:Name="KlipperPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UrlBox" Grid.Column="1" Grid.ColumnSpan="2" />
            <TextBlock x:Name="AddressHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="The address you open Mainsail or Fluidd at, e.g. mainsail.local or 192.168.1.50" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="API key" VerticalAlignment="Center" />
                <TextBlock x:Name="ApiKeyInfo" Text="&#x24D8;" FontSize="15" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Cursor="Help"
                           ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="380">
                                <Run Text="Usually not needed." FontWeight="SemiBold" />
                                <Run Text="Moonraker lets devices on your home network in without a key (its trusted_clients setting covers 192.168.x.x, 10.x.x.x and 172.16–31.x.x addresses by default)." />
                                <LineBreak /><LineBreak />
                                <Run Text="You'll need it if:" />
                                <LineBreak />
                                <Run Text="•  this PC reaches the printer over Tailscale, another VPN or the internet" />
                                <LineBreak />
                                <Run Text="•  trusted_clients in moonraker.conf has been narrowed" />
                                <LineBreak />
                                <Run Text="•  Mainsail/Fluidd is set to require a login" />
                                <LineBreak /><LineBreak />
                                <Run Text="If Test connection says Moonraker refused access, add the key here. To get it, run ~/moonraker/scripts/fetch-apikey.sh on the printer." />
                            </TextBlock>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>
            <Grid Grid.Row="2" Grid.Column="1">
                <PasswordBox x:Name="ApiKeyHidden" Padding="10,5,36,6" />
                <TextBox x:Name="ApiKeyVisible" Padding="10,5,36,6" Visibility="Collapsed" />
                <ToggleButton x:Name="ShowApiKey" Style="{StaticResource EyeToggle}"
                              Checked="OnShowApiKeyChanged" Unchecked="OnShowApiKeyChanged" />
            </Grid>
            <Button x:Name="TestButton" Grid.Row="2" Grid.Column="2" Content="Test connection" Margin="8,0,0,0"
                    Click="OnTestClick" />
            <!-- The test's result takes the hint's place. -->
            <TextBlock x:Name="ApiKeyHint" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Optional — leave blank unless Moonraker asks for one." />
            <TextBlock x:Name="TestResult" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Opacity="1" Visibility="Collapsed" />

            <!-- Filled from the printer's webcam list once it's been reached. -->
        </Grid>

        <!-- Bambu -->
        <Grid x:Name="BambuPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="IP address" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="IpBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="Serial number" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SerialBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                     CharacterCasing="Upper" />
            <TextBlock Grid.Row="2" Text="Access code" Style="{StaticResource FieldLabel}" />
            <Grid Grid.Row="2" Grid.Column="1">
                <PasswordBox x:Name="CodeHidden" Padding="10,5,36,6" />
                <TextBox x:Name="CodeVisible" Padding="10,5,36,6" Visibility="Collapsed" />
                <ToggleButton x:Name="ShowCode" Style="{StaticResource EyeToggle}"
                              Checked="OnShowCodeChanged" Unchecked="OnShowCodeChanged" />
            </Grid>
            <Button x:Name="BambuTestButton" Grid.Row="2" Grid.Column="2" Content="Test connection" Margin="8,0,0,0"
                    Click="OnTestClick" />
            <TextBlock x:Name="BambuTestResult" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Opacity="1" Visibility="Collapsed" />
            <TextBlock x:Name="BambuHint" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="All three are on the printer's screen under Settings → WLAN / Network. For the camera, turn on “LAN Mode Live View”. LAN Only Mode is not required." />
        </Grid>


        <!-- Klipper: what the popup shows, below the connection test. -->
        <Grid x:Name="KlipperOptions" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Camera" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CameraCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                      HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="OnCameraChanged" />
            <!-- How each camera is fetched: every kind the app supports, greyed out where the camera doesn't offer it. -->
            <ComboBox x:Name="CameraStreamCombo" Grid.Row="0" Grid.Column="2" Width="170" Margin="8,0,0,8"
                      ItemTemplate="{StaticResource StreamItem}" ItemContainerStyle="{StaticResource StreamItemContainer}"
                      ToolTip="{StaticResource StreamTip}" />
            <TextBlock x:Name="SecondViewLabel" Grid.Row="1" Text="Second view" Style="{StaticResource FieldLabel}" />
            <!-- On a U1 Extended, the printer's touchscreen is one of the choices. -->
            <ComboBox x:Name="SecondViewCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemTemplate="{StaticResource StreamItem}" ItemContainerStyle="{StaticResource StreamItemContainer}"
                      SelectionChanged="OnCameraChanged" />
            <ComboBox x:Name="SecondViewStreamCombo" Grid.Row="1" Grid.Column="2" Width="170" Margin="8,0,0,0"
                      ItemTemplate="{StaticResource StreamItem}" ItemContainerStyle="{StaticResource StreamItemContainer}"
                      ToolTip="{StaticResource StreamTip}" />
            <TextBlock x:Name="SourcesHint" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Test connection lists the printer's cameras and the streams each one offers." />

            <CheckBox x:Name="ConsoleCheck" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,8"
                      Content="Show the Klipper console next to the webcam"
                      ToolTip="It hides the same messages as Mainsail's console, using Mainsail's console filters." />
            <!-- Off by default: it can start prints. Greyed out if the printer has no queue. -->
            <CheckBox x:Name="QueueCheck" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,8"
                      Content="Show the print queue in the webcam popup"
                      ToolTip="Queued jobs with drag-to-reorder, recent uploads to add, and a button that starts the next print." />

            <!-- The stats strip at the top of the popup's side panel: up to 6 tiles, in this order. -->
            <!-- The strip, the whole width, as wide as there's room for: it's six tiles. -->
            <TextBlock Grid.Row="5" Text="Stats strip" Style="{StaticResource FieldLabel}" Margin="0,6,16,6" />
            <TextBlock x:Name="StatsHint" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" Margin="0" />
            <UniformGrid x:Name="StatsSlots" Grid.Row="6" Grid.ColumnSpan="3" Rows="1" Margin="0,2,-6,4" />
        </Grid>

        <Separator Margin="0,8,0,16" />

        <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Check printer every" VerticalAlignment="Center" />
            <TextBox x:Name="IntervalBox" Width="64" Margin="10,0" HorizontalContentAlignment="Center"
                     PreviewTextInput="OnIntervalPreviewInput" />
            <TextBlock Text="seconds" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox x:Name="NotifyCheck" Content="Notify me when a print finishes, fails or pauses" Margin="0,0,0,6" />
        <CheckBox x:Name="AutostartCheck" Content="Start with Windows" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="SaveButton" Content="Save" MinWidth="96" IsDefault="True" Click="OnSaveClick"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True"
                    Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
