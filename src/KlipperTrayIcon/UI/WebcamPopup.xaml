<Window x:Class="KlipperTrayIcon.UI.WebcamPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Webcam"
        ThemeMode="None"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="Black"
        Height="482"
        Width="642">
    <!-- Our own slim title bar (the top 28 px act as Windows' caption: drag,
         double-click to maximize, snapping), with the native resize borders. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" GlassFrameThickness="0" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC0000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource CloseButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Print queue: small buttons in the rows, and the start button. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#BDBDBD" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Start next: small and quiet, in the queue's header. Turns amber when armed. -->
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="9,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A thin, dark scroll bar that doesn't compete with the content. -->
        <Style x:Key="SubtleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="#3A3A3A" CornerRadius="2" Width="4"
                                                    HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#5A5A5A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A thumbnail (the slicer's preview), a name and a detail line. -->
        <!-- Hovering over a thumbnail shows the slicer's biggest one, after a tooltip's delay. Moving to
             another thumbnail while it's open switches straight away (the tooltip's BetweenShowDelay). -->
        <Style x:Key="PreviewOnHover" TargetType="Border">
            <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="400" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="ToolTipService.Placement" Value="Left" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="-8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="FileInfo">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="#3A3A3A" CornerRadius="3" Margin="0,0,9,0"
                        Style="{StaticResource PreviewOnHover}">
                    <Border.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False">
                            <ToolTip.Template>
                                <ControlTemplate TargetType="ToolTip">
                                    <Border Background="#3A3A3A" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <Image Source="{Binding Preview}" Width="240" Height="240" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </ControlTemplate>
                            </ToolTip.Template>
                        </ToolTip>
                    </Border.ToolTip>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="#ECECEC" FontSize="13" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding Detail}" Foreground="#9A9A9A" FontSize="11" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- A queued job: drag it to reorder (an open hand over it says so), ✕ (on hover) to remove. -->
        <DataTemplate x:Key="QueueRow">
            <Border x:Name="Row" Background="#141414" CornerRadius="4" Padding="6,4,4,4" Cursor="{DynamicResource GrabCursor}"
                    MouseLeftButtonDown="OnRowMouseDown" MouseMove="OnRowMouseMove"
                    MouseLeftButtonUp="OnRowMouseUp" LostMouseCapture="OnRowLostCapture">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileInfo}" />
                    <Button x:Name="Remove" Grid.Column="1" Content="&#x2715;" FontSize="11" Style="{StaticResource RowButton}"
                            Visibility="Hidden" ToolTip="Remove from the queue" Click="OnQueueRemoveClick" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#1E1E1E" />
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- A recently uploaded file: ＋ adds it to the end of the queue; drag it into the queue to put it anywhere. -->
        <DataTemplate x:Key="RecentRow">
            <Border x:Name="Row" Background="#141414" CornerRadius="4" Padding="6,4,4,4" Cursor="{DynamicResource GrabCursor}"
                    MouseLeftButtonDown="OnRowMouseDown" MouseMove="OnRowMouseMove"
                    MouseLeftButtonUp="OnRowMouseUp" LostMouseCapture="OnRowLostCapture">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileInfo}" />
                    <Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Style="{StaticResource RowButton}" ToolTip="Add to the end of the queue" Click="OnQueueAddClick" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#1E1E1E" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="#404040" BorderThickness="1">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Switches to the second view (picked in Settings) and back. -->
                    <Button x:Name="ViewButton" FontSize="13" Visibility="Collapsed"
                            Style="{StaticResource PinButton}" Click="OnViewClick" />
                    <!-- Only on a view that takes taps; locked (view-only) until clicked. -->
                    <Button x:Name="TouchButton" FontSize="13" Visibility="Collapsed"
                            Style="{StaticResource PinButton}" Click="OnTouchLockClick" />
                    <!-- Switches the side panel between the console and the print queue. -->
                    <Button x:Name="QueueButton" FontSize="13" Visibility="Collapsed"
                            Style="{StaticResource PinButton}" Click="OnQueueButtonClick" />
                    <Button x:Name="PinButton" Content="&#xE718;" FontSize="13"
                            Style="{StaticResource PinButton}" Click="OnPinClick"
                            ToolTip="Pin: keep open when you click elsewhere" />
                    <Button Content="&#x2715;" FontSize="11"
                            Style="{StaticResource CloseButton}" Click="OnCloseClick" />
                </StackPanel>
                <!-- A grid, not a StackPanel, so a long file name is trimmed rather than run under the buttons. -->
                <Grid VerticalAlignment="Center" Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#808080" Margin="0,1,8,0" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="#D8D8D8" FontSize="12" />
                    <TextBlock x:Name="TitleFile" Grid.Column="2" Foreground="#9A9A9A" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Console beside the video, or below it in tall windows (see UpdateArrangement). -->
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ConsoleColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="VideoRow" Height="*" />
                <RowDefinition x:Name="ConsoleRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Video -->
            <Grid Background="Black" ClipToBounds="True">
                <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- While touch is unlocked: clicks on the picture go to the printer. -->
                <Border x:Name="TouchOutline" BorderBrush="#E3B341" BorderThickness="2" IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Border Background="#E3B341" CornerRadius="0,0,4,0" Padding="7,2" HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <TextBlock Text="Touch on · clicks go to the printer" Foreground="#141414" FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </Border>
                <TextBlock x:Name="Placeholder" Text="Connecting..." Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Shown over a snapshot until live video takes over. -->
                <Border x:Name="Badge" Background="#D9202020" CornerRadius="4" Padding="8,3" Margin="8"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" Foreground="#D8D8D8" FontSize="11" />
                </Border>
            </Grid>

            <!-- Klipper console -->
            <Border x:Name="ConsolePanel" Grid.Column="1" Background="#141414"
                    BorderBrush="#404040" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <!-- Key stats, fed by the tray's status updates. -->
                    <Border x:Name="StatsStrip" DockPanel.Dock="Top" Background="#1C1C1C" BorderBrush="#404040" BorderThickness="0,0,0,1">
                        <Grid>
                            <ItemsControl x:Name="StatsList" Margin="6,8,62,9">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <!-- With six tiles a long value ("1h 34m") can be a little too wide: it
                                         shrinks to fit rather than being cut off. -->
                                    <DataTemplate>
                                        <StackPanel Margin="5,0">
                                            <TextBlock Text="{Binding Label}" Foreground="#9A9A9A" FontSize="10"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="17"
                                                           FontWeight="SemiBold" />
                                            </Viewbox>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Detail}" Foreground="#A0A0A0" FontSize="11" />
                                            </Viewbox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Print progress along the bottom edge. -->
                            <Rectangle x:Name="ProgressBar" Height="3" VerticalAlignment="Bottom"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <Grid>
                    <DockPanel x:Name="ConsoleView">
                    <TextBlock DockPanel.Dock="Top" Text="CONSOLE" Foreground="#9A9A9A" FontSize="11"
                               FontWeight="SemiBold" Margin="12,7,12,6" />
                    <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="ConsoleList" Margin="12,0,12,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="#7A7A7A" FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}" Margin="0,1,10,0"
                                                   Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- Second column: wrapped and multi-line messages stay under the
                                             message, never under the time. -->
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Brush}"
                                                   FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}"
                                                   FontSize="13" LineHeight="18"
                                                   FontFamily="{Binding FontFamily}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </DockPanel>

                    <!-- Print queue (Moonraker's job queue), in place of the console. -->
                    <DockPanel x:Name="QueueView" Visibility="Collapsed">
                        <Grid DockPanel.Dock="Top" Margin="12,5,10,5" MinHeight="22">
                            <TextBlock x:Name="QueueHeader" Text="QUEUE" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <!-- Either the start button, or why there's nothing to start. -->
                            <TextBlock x:Name="QueueStateText" Foreground="#8C8C8C" FontSize="11" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" />
                            <Button x:Name="StartNextButton" Style="{StaticResource StartButton}" Click="OnStartNextClick"
                                    HorizontalAlignment="Right" Visibility="Collapsed" />
                        </Grid>
                        <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SubtleScrollBar}" />
                            </ScrollViewer.Resources>
                            <StackPanel x:Name="QueueContent" Margin="6,0,8,8">
                                <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueRow}" />
                                <!-- Everything under the queue, moved down together while a recent upload is dragged into it. -->
                                <StackPanel x:Name="BelowQueue">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform />
                                    </StackPanel.RenderTransform>
                                    <TextBlock x:Name="QueueEmpty" Text="Nothing queued. Add a file from the recent uploads below."
                                               Foreground="#8C8C8C" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                               Margin="6,2,6,4" Visibility="Collapsed" />
                                    <TextBlock x:Name="RecentHeading" Text="RECENT UPLOADS" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold"
                                               Margin="6,14,6,6" />
                                    <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RecentRow}" />
                                    <Button x:Name="LoadMoreButton" Content="Load more" Style="{StaticResource RowButton}"
                                            Width="Auto" Height="26" FontSize="12" Foreground="#8C8C8C" Margin="0,2,0,0"
                                            Visibility="Collapsed" Click="OnLoadMoreClick" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>
      </DockPanel>
    </Border>
</Window>
