<modules:ModulePanel x:Class="KlipperTrayIcon.Modules.Afc.AfcPanel"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:modules="clr-namespace:KlipperTrayIcon.Modules">
    <!-- AFC: the unit's lanes, the path to the toolhead and its sensors, drawn in code (AfcPanel.xaml.cs). -->
    <modules:ModulePanel.Resources>
        <!-- Load, Eject, Unload and Resume: small and quiet; amber while waiting for the second click
             (Tag "armed"), dim when they can't run, with why in the tooltip. -->
        <Style x:Key="ActButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#303030" />
                            </Trigger>
                            <Trigger Property="Tag" Value="armed">
                                <Setter TargetName="Bg" Property="Background" Value="#E3B341" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#E3B341" />
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <!-- A thin, dark scroll bar, as on the other pages. -->
        <Style x:Key="SubtleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A3A3A" CornerRadius="2" Width="4" HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </modules:ModulePanel.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SubtleScrollBar}" />
        </ScrollViewer.Resources>
        <StackPanel>
            <!-- NIGHTOWL, and what AFC is doing. -->
            <Grid x:Name="Header" Margin="14,10,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UnitText" Text="AFC" Foreground="#8A8A8A" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StateText" Grid.Column="1" Foreground="#DADADA" FontSize="12" Margin="10,0,0,0"
                           VerticalAlignment="Bottom" />
            </Grid>
            <!-- AFC's error (or a command's), with Resume. -->
            <Grid x:Name="MessageRow" Margin="10,2,10,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MessageText" Foreground="#E3B341" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="4,0,0,0" />
                <Button x:Name="ResumeButton" Grid.Column="1" Style="{StaticResource ActButton}" Content="Resume"
                        Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="OnResumeClick" />
            </Grid>
            <Canvas x:Name="Drawing" Width="400" Height="348" HorizontalAlignment="Left" Margin="0,4,0,6" />
        </StackPanel>
    </ScrollViewer>
</modules:ModulePanel>
