<modules:ModuleConsoleInput x:Class="KlipperTrayIcon.Modules.Commands.CommandBox"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:modules="clr-namespace:KlipperTrayIcon.Modules">
    <!-- A box under the console to type commands in, with a dropdown over the console's last lines. -->
    <modules:ModuleConsoleInput.Resources>
        <!-- Send: small and quiet, like Spoolman's Use. Filled blue while it asks for the second click (Tag "armed"). -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="Tag" Value="armed">
                                <Setter TargetName="Bg" Property="Background" Value="#60CDFF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#60CDFF" />
                                <Setter Property="Foreground" Value="#002033" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The box itself: just the text, whatever the app's theme (its frame is drawn around it). -->
        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Pin and Unpin: a small dark menu. -->
        <Style x:Key="Menu" TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#2B2B2B" BorderBrush="#454545" BorderThickness="1" CornerRadius="5" Padding="4">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuEntry" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="10,4" MinWidth="100">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </modules:ModuleConsoleInput.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- One amber line: a typo, the guard while printing, or why it couldn't send. -->
        <TextBlock x:Name="Say" Foreground="#E3B341" FontSize="12" Margin="12,0,10,2" TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed" />

        <Grid Grid.Row="1" Margin="10,6,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Frame" Height="26" Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="›" Foreground="#8A8A8A" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Grid Grid.Column="1">
                        <!-- Under the box: the rest of the top suggestion, after what's typed (drawn invisibly to line it up). -->
                        <TextBlock x:Name="Ghost" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="2,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"><Run x:Name="GhostTyped" Foreground="Transparent" /><Run
                                   x:Name="GhostRest" Foreground="#5F5F5F" /></TextBlock>
                        <TextBlock x:Name="Placeholder" Foreground="#6A6A6A" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="#DADADA" CaretBrush="#DADADA"
                                 SelectionBrush="#3A8EE0" SelectionOpacity="0.45" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                 Padding="0" VerticalAlignment="Center" Style="{StaticResource Box}" />
                    </Grid>
                </Grid>
            </Border>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="6,0,0,0" Style="{StaticResource SendButton}"
                    Click="OnSendClick" />
        </Grid>

        <!-- The dropdown: drawn upward from the top of this control, over the console's lines. -->
        <Canvas Height="0" VerticalAlignment="Top" Panel.ZIndex="1">
            <Border x:Name="Dropdown" Canvas.Left="10" Canvas.Bottom="0" Background="#232323" BorderBrush="#454545"
                    BorderThickness="1" CornerRadius="5" Padding="0,4" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black" />
                </Border.Effect>
                <StackPanel x:Name="DropList" />
            </Border>
        </Canvas>
    </Grid>
</modules:ModuleConsoleInput>
