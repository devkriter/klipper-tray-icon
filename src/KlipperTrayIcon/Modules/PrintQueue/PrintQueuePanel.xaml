<modules:ModulePanel x:Class="KlipperTrayIcon.Modules.PrintQueue.PrintQueuePanel"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:modules="clr-namespace:KlipperTrayIcon.Modules">
    <!-- The print queue (Moonraker's job queue), in the popup's side panel. -->
    <modules:ModulePanel.Resources>
        <!-- Print queue: small buttons in the rows, and the start button. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#BDBDBD" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Start next: small and quiet, in the queue's header. Turns amber when armed. -->
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="9,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A thin, dark scroll bar that doesn't compete with the content. -->
        <Style x:Key="SubtleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="#3A3A3A" CornerRadius="2" Width="4"
                                                    HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#5A5A5A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A thumbnail (the slicer's preview), a name and a detail line. -->
        <!-- Hovering over a thumbnail shows the slicer's biggest one, after a tooltip's delay. Moving to
             another thumbnail while it's open switches straight away (the tooltip's BetweenShowDelay). -->
        <Style x:Key="PreviewOnHover" TargetType="Border">
            <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="400" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="ToolTipService.Placement" Value="Left" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="-8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="FileInfo">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="#3A3A3A" CornerRadius="3" Margin="0,0,9,0"
                        Style="{StaticResource PreviewOnHover}">
                    <Border.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False">
                            <ToolTip.Template>
                                <ControlTemplate TargetType="ToolTip">
                                    <Border Background="#3A3A3A" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <Image Source="{Binding Preview}" Width="240" Height="240" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </ControlTemplate>
                            </ToolTip.Template>
                        </ToolTip>
                    </Border.ToolTip>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="#ECECEC" FontSize="13" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding Detail}" Foreground="#9A9A9A" FontSize="11" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- ▶ on a row (on hover): prints that file now. The first click turns it into an amber "Confirm",
             like Start next. While the printer is busy (or offline) it's there but greyed out. -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource StartButton}">
            <!-- Compact, to sit with ✕ and ＋: Start next's look at about their size. -->
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="IsEnabled" Value="{DynamicResource PlayEnabled}" />
            <Setter Property="ToolTip" Value="Print now" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="ToolTip" Value="Can be started when the printer is idle" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlayGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x25B6;" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#5FC27A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                    <Setter Property="Foreground" Value="#8C8C8C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A queued job: drag it to reorder (an open hand over it says so), ▶ to print it now, ✕ to remove
             (both on hover). -->
        <DataTemplate x:Key="QueueRow">
            <Border x:Name="Row" Background="#141414" CornerRadius="4" Padding="6,4,4,4" Cursor="{DynamicResource GrabCursor}"
                    MouseLeftButtonDown="OnRowMouseDown" MouseMove="OnRowMouseMove"
                    MouseLeftButtonUp="OnRowMouseUp" LostMouseCapture="OnRowLostCapture">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileInfo}" />
                    <Border Grid.Column="1" Visibility="{DynamicResource PlayVisibility}">
                        <Button x:Name="Play" Style="{StaticResource PlayButton}" Click="OnPlayClick">
                            <TextBlock Style="{StaticResource PlayGlyph}" />
                        </Button>
                    </Border>
                    <Button x:Name="Remove" Grid.Column="2" Content="&#x2715;" FontSize="11" Style="{StaticResource RowButton}"
                            Visibility="Hidden" ToolTip="Remove from the queue" Click="OnQueueRemoveClick" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#1E1E1E" />
                    <Setter TargetName="Play" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- A recently uploaded file: ▶ prints it now, ＋ adds it to the end of the queue (both on hover); drag it
             into the queue to put it anywhere. -->
        <DataTemplate x:Key="RecentRow">
            <Border x:Name="Row" Background="#141414" CornerRadius="4" Padding="6,4,4,4" Cursor="{DynamicResource GrabCursor}"
                    MouseLeftButtonDown="OnRowMouseDown" MouseMove="OnRowMouseMove"
                    MouseLeftButtonUp="OnRowMouseUp" LostMouseCapture="OnRowLostCapture">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileInfo}" />
                    <Border Grid.Column="1" Visibility="{DynamicResource PlayVisibility}">
                        <Button x:Name="Play" Style="{StaticResource PlayButton}" Click="OnPlayClick">
                            <TextBlock Style="{StaticResource PlayGlyph}" />
                        </Button>
                    </Border>
                    <Button x:Name="Add" Grid.Column="2" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Style="{StaticResource RowButton}" Visibility="Hidden" ToolTip="Add to the end of the queue"
                            Click="OnQueueAddClick" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#1E1E1E" />
                    <Setter TargetName="Play" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Add" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </modules:ModulePanel.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="12,5,10,5" MinHeight="22">
            <TextBlock x:Name="QueueHeader" Text="QUEUE" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <!-- Either the start button, or why there's nothing to start. -->
            <TextBlock x:Name="QueueStateText" Foreground="#8C8C8C" FontSize="11" HorizontalAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" />
            <Button x:Name="StartNextButton" Style="{StaticResource StartButton}" Click="OnStartNextClick"
                    HorizontalAlignment="Right" Visibility="Collapsed" />
        </Grid>
        <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SubtleScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="QueueContent" Margin="6,0,8,8">
                <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueRow}" />
                <!-- Everything under the queue, moved down together while a recent upload is dragged into it. -->
                <StackPanel x:Name="BelowQueue">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="QueueEmpty" Text="Nothing queued. Add a file from the recent uploads below."
                               Foreground="#8C8C8C" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                               Margin="6,2,6,4" Visibility="Collapsed" />
                    <TextBlock x:Name="RecentHeading" Text="RECENT UPLOADS" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold"
                               Margin="6,14,6,6" />
                    <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RecentRow}" />
                    <Button x:Name="LoadMoreButton" Content="Load more" Style="{StaticResource RowButton}"
                            Width="Auto" Height="26" FontSize="12" Foreground="#8C8C8C" Margin="0,2,0,0"
                            Visibility="Collapsed" Click="OnLoadMoreClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</modules:ModulePanel>
