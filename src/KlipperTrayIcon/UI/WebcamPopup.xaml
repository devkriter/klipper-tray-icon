<Window x:Class="KlipperTrayIcon.UI.WebcamPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Webcam"
        ThemeMode="None"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="Black"
        Height="482"
        Width="642">
    <!-- Our own slim title bar (the top 28 px act as Windows' caption: drag,
         double-click to maximize, snapping), with the native resize borders. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" GlassFrameThickness="0" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC0000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource CloseButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- E-Stop: small and dim over the video; solid red while it waits for the second click (Tag "armed"). -->
        <Style x:Key="EStop" TargetType="Button">
            <Setter Property="Foreground" Value="#FF9A93" />
            <Setter Property="Background" Value="#8C000000" />
            <Setter Property="BorderBrush" Value="#59FF7B72" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC000000" />
                            </Trigger>
                            <Trigger Property="Tag" Value="armed">
                                <Setter TargetName="Bg" Property="Background" Value="#DA3633" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#DA3633" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="#404040" BorderThickness="1">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Switches to the second view (picked in Settings) and back. -->
                    <Button x:Name="ViewButton" FontSize="13" Visibility="Collapsed"
                            Style="{StaticResource PinButton}" Click="OnViewClick" />
                    <!-- Only on a view that takes taps; locked (view-only) until clicked. -->
                    <Button x:Name="TouchButton" FontSize="13" Visibility="Collapsed"
                            Style="{StaticResource PinButton}" Click="OnTouchLockClick" />
                    <!-- What the side panel shows: the console, or a module's panel. One button each,
                         side by side (only when there's more than one), the console's on the right; filled in code. -->
                    <StackPanel x:Name="PanelButtons" Orientation="Horizontal" />
                    <Button x:Name="PinButton" Content="&#xE718;" FontSize="13"
                            Style="{StaticResource PinButton}" Click="OnPinClick"
                            ToolTip="Pin: keep open when you click elsewhere" />
                    <Button Content="&#x2715;" FontSize="11"
                            Style="{StaticResource CloseButton}" Click="OnCloseClick" />
                </StackPanel>
                <!-- A grid, not a StackPanel, so a long file name is trimmed rather than run under the buttons. -->
                <Grid VerticalAlignment="Center" Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#808080" Margin="0,1,8,0" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="#D8D8D8" FontSize="12" />
                    <TextBlock x:Name="TitleFile" Grid.Column="2" Foreground="#9A9A9A" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Console beside the video, or below it in tall windows (see UpdateArrangement). -->
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ConsoleColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="VideoRow" Height="*" />
                <RowDefinition x:Name="ConsoleRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Video -->
            <Grid x:Name="VideoArea" Background="Black" ClipToBounds="True">
                <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- While touch is unlocked: clicks on the picture go to the printer. -->
                <Border x:Name="TouchOutline" BorderBrush="#E3B341" BorderThickness="2" IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Border Background="#E3B341" CornerRadius="0,0,4,0" Padding="7,2" HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <TextBlock Text="Touch on · clicks go to the printer" Foreground="#141414" FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </Border>
                <TextBlock x:Name="Placeholder" Text="Connecting..." Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Shown over a snapshot until live video takes over. -->
                <Border x:Name="Badge" Background="#D9202020" CornerRadius="4" Padding="8,3" Margin="8"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" Foreground="#D8D8D8" FontSize="11" />
                </Border>
                <!-- Klipper's emergency stop, top right, only while the mouse is over the video. The first
                     click arms it (solid red); a second within 3 s stops the printer. -->
                <Button x:Name="EStopButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                        Visibility="Collapsed" Style="{StaticResource EStop}" Click="OnEStopClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2.5,0.3 L7.5,0.3 L10,5 L7.5,9.7 L2.5,9.7 L0,5 Z" Width="10" Height="10"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="EStopText" Text="E-Stop" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Klipper console -->
            <Border x:Name="ConsolePanel" Grid.Column="1" Background="#141414"
                    BorderBrush="#404040" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <!-- Key stats, fed by the tray's status updates. -->
                    <Border x:Name="StatsStrip" DockPanel.Dock="Top" Background="#1C1C1C" BorderBrush="#404040" BorderThickness="0,0,0,1">
                        <Grid>
                            <ItemsControl x:Name="StatsList" Margin="6,8,62,9">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <!-- With six tiles a long value ("1h 34m") can be a little too wide: it
                                         shrinks to fit rather than being cut off. -->
                                    <DataTemplate>
                                        <StackPanel Margin="5,0">
                                            <TextBlock Text="{Binding Label}" Foreground="#9A9A9A" FontSize="10"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="17"
                                                           FontWeight="SemiBold" />
                                            </Viewbox>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Detail}" Foreground="#A0A0A0" FontSize="11" />
                                            </Viewbox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Print progress along the bottom edge. -->
                            <Rectangle x:Name="ProgressBar" Height="3" VerticalAlignment="Bottom"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <!-- The console, or a module's panel (Modules/) in its place: see the title bar's panel buttons. -->
                    <Grid x:Name="PanelHost">
                    <DockPanel x:Name="ConsoleView">
                    <TextBlock DockPanel.Dock="Top" Text="CONSOLE" Foreground="#9A9A9A" FontSize="11"
                               FontWeight="SemiBold" Margin="12,7,12,6" />
                    <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <!-- One read-only document (ConsoleText), so lines can be selected across and copied. -->
                        <RichTextBox x:Name="ConsoleBox" Margin="12,0,12,8" IsReadOnly="True" IsDocumentEnabled="True"
                                     Background="Transparent" BorderThickness="0" Padding="0" Foreground="#ECECEC"
                                     SelectionBrush="#60CDFF" SelectionOpacity="0.35" CaretBrush="Transparent"
                                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                     FocusVisualStyle="{x:Null}" />
                    </ScrollViewer>
                    </DockPanel>

                    </Grid>
                </DockPanel>
            </Border>

        </Grid>
      </DockPanel>
    </Border>
</Window>
